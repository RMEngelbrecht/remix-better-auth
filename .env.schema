# Environment schema for this app, loaded by varlock (https://varlock.dev).
# Put local values in a git-ignored `.env.local`.
#
# @defaultSensitive=false @defaultRequired=false
# @generateTsTypes(path=env.d.ts)
# ---

# Secret used by better-auth to sign cookies and tokens (at least 32 characters).
# Required in production; development and tests fall back to an insecure default.
# Generate one with `openssl rand -base64 32`.
# @sensitive @type=string(minLength=32)
# @docs(https://www.better-auth.com/docs/installation#set-environment-variables)
BETTER_AUTH_SECRET=

# Public URL the app is served from. Defaults to http://localhost:<PORT>.
# @type=url @example=https://app.example.com
BETTER_AUTH_URL=
